    <path android:fillColor="#191B1F" android:pathData="M243,578h9v40h-9z"/>
    <!-- Woodfire flame -->
    <path android:fillColor="#E8EEF6"
        android:pathData="M276.5,580C280,588 288,593 288,603C288,610 283,616 276.5,616C270,616 265,610 265,603.5C265,598 268,594 271,591C271,595 273,598 275.5,598.5C274,592 274.5,586 276.5,580Z"/>
