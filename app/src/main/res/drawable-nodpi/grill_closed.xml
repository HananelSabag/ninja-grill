    <path android:fillColor="#0D0F12" android:strokeColor="#2E333A" android:strokeWidth="1.5"
        android:pathData="M300,574h118a4,4 0,0 1,4 4v41a4,4 0,0 1,-4 4h-118a4,4 0,0 1,-4 -4v-41a4,4 0,0 1,4 -4z"/>
    <!-- Buttons under the display -->
    <path android:strokeColor="#59606A" android:strokeWidth="1.5" android:fillColor="#00000000"
        android:pathData="M216,628h34a6,6 0,0 1,0 12h-34a6,6 0,0 1,0 -12zM262,628h34a6,6 0,0 1,0 12h-34a6,6 0,0 1,0 -12zM322,628h34a6,6 0,0 1,0 12h-34a6,6 0,0 1,0 -12zM370,628h34a6,6 0,0 1,0 12h-34a6,6 0,0 1,0 -12z"/>
    <!-- Dial -->
    <path android:fillColor="#25292E" android:pathData="M427,600a28,28 0,1 0,56 0a28,28 0,1 0,-56 0z"/>
    <path android:pathData="M432,600a23,23 0,1 0,46 0a23,23 0,1 0,-46 0z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear" android:startX="440" android:startY="580" android:endX="472" android:endY="622">
                <item android:offset="0" android:color="#FFF3F5F8"/>
                <item android:offset="1" android:color="#FF8E97A1"/>
            </gradient>
        </aapt:attr>
    </path>
    <path android:fillColor="#5D6570" android:pathData="M453.5,582h3v9h-3z"/>
    <!-- Start / stop and the probe jack -->
    <path android:strokeColor="#8C949E" android:strokeWidth="2" android:fillColor="#00000000"
        android:pathData="M488,589a12,12 0,1 0,24 0a12,12 0,1 0,-24 0z"/>
    <path android:strokeColor="#6B737D" android:strokeWidth="1.6" android:fillColor="#00000000"
        android:pathData="M491,625a9,9 0,1 0,18 0a9,9 0,1 0,-18 0zM496,625h8"/>
</vector>
