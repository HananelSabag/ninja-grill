                <item android:offset="0" android:color="#FFEEF1F5"/>
                <item android:offset="1" android:color="#FF98A1AB"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- Our flame, pressed into the hood -->
    <group android:translateX="322.2" android:translateY="285" android:scaleX="0.7" android:scaleY="0.7">
        <path android:fillColor="#FFFFFF" android:fillAlpha="0.24"
            android:pathData="M54,24C60,36 72,44 72,60C72,72 64,82 54,82C44,82 36,72 36,61C36,52 41,46 45,41C45,48 48,52 52,53C50,44 51,33 54,24Z"/>
