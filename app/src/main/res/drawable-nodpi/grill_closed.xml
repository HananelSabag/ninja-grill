            <gradient android:type="linear" android:startX="0" android:startY="204" android:endX="0" android:endY="528">
                <item android:offset="0" android:color="#FF7FA3CB"/>
                <item android:offset="0.45" android:color="#FF5A7EA7"/>
                <item android:offset="1" android:color="#FF3F6086"/>
            </gradient>
        </aapt:attr>
    </path>
    <!-- Light catching the shoulders -->
    <path android:fillColor="#FFFFFF" android:fillAlpha="0.14"
        android:pathData="M112,296Q118,256 170,252L236,250L236,262L172,266Q130,270 124,300L120,350L108,350Z"/>
    <path android:fillColor="#FFFFFF" android:fillAlpha="0.10"
        android:pathData="M244,240Q246,216 270,216L450,216Q474,216 476,240Z"/>

    <!-- Top handle -->
    <path android:fillColor="#1E2226" android:pathData="M248,192h224v14h-224z"/>
