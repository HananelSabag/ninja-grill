    <path android:pathData="M132,528L140,400Q142,384 158,384L562,384Q578,384 580,400L588,528Z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear" android:startX="0" android:startY="384" android:endX="0" android:endY="528">
