<?xml version="1.0" encoding="utf-8"?>
<!--
  The grill, lid closed: our own drawing of an OG901-style grill (no vendor photo, no logo).
  It keeps the photo canvas (720×715) and its panel layout, because GrillCard.kt draws the live
  display, the mode LEDs and the Woodfire flame at fixed fractions of this canvas:
  display 300–418 × 578–619, LEDs x 243–252, flame 265–288 × 578–617.
  A local build can swap in its own picture: app/src/debug/res/drawable-nodpi/grill_closed.png.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="720dp" android:height="715dp"
    android:viewportWidth="720" android:viewportHeight="715">

    <!-- Ground shadow -->
    <path android:fillColor="#000000" android:fillAlpha="0.16"
        android:pathData="M60,704a300,9 0,1 0,600 0a300,9 0,1 0,-600 0z"/>

    <!-- Side smoke box (right) and the hood's dark left flank -->
    <path android:fillColor="#2B2F35" android:pathData="M598,262h80a14,14 0,0 1,14 14v244h-94z"/>
    <path android:fillColor="#3A3F46" android:pathData="M688,394h18a5,5 0,0 1,5 5v18a5,5 0,0 1,-5 5h-18z"/>
    <path android:fillColor="#23272C" android:pathData="M60,286a16,16 0,0 1,16 -16h40v250h-56z"/>

    <!-- Hood -->
