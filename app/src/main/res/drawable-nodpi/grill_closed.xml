    </path>
    <path android:fillColor="#111316" android:pathData="M92,690h58v14a4,4 0,0 1,-4 4h-50a4,4 0,0 1,-4 -4z"/>
    <path android:fillColor="#111316" android:pathData="M570,690h58v14a4,4 0,0 1,-4 4h-50a4,4 0,0 1,-4 -4z"/>

